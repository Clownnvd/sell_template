{
  "name": "king-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && cross-env __NEXT_PRIVATE_STANDALONE_CONFIG= __NEXT_PRIVATE_ORIGIN= NEXT_OTEL_FETCH_DISABLED= next build",
