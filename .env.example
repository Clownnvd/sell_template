# ──────────────────────────────────────────────
# Neon PostgreSQL
# ──────────────────────────────────────────────
# Pooled connection for queries (must include ?sslmode=require&pgbouncer=true)
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# Direct connection for migrations (must include ?sslmode=require, NO pgbouncer)
DIRECT_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
BETTER_AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth - Google (optional)
# Get credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub (optional)
# Get credentials at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Stripe
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ──────────────────────────────────────────────
# GitHub Integration (optional — repo invite after purchase)
# ──────────────────────────────────────────────
GITHUB_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ──────────────────────────────────────────────
# Email (Resend — optional)
# ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=

# ──────────────────────────────────────────────
# Rate Limiting (Upstash Redis — optional)
# Falls back to in-memory for development
# Get credentials at: https://console.upstash.com
# ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────
# SePay - Vietnamese Payment Gateway (optional)
# Get credentials at: https://my.sepay.vn
# ──────────────────────────────────────────────
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_WEBHOOK_KEY=
